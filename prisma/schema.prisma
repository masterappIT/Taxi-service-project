generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  phone     String?  @unique
  name      String?
  createdAt DateTime @default(now())
  trips     Trip[]
}

model Trip {
  id          String     @id @default(cuid())
  userId      String
  origin      String
  destination String
  region      Region
  scheduledAt DateTime
  status      TripStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([scheduledAt])
}

enum Region {
  HK
  MACAU
  GUANGDONG
}

enum TripStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}
